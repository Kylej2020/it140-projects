# Project One Get-Item Pseudocode
#
# Graded checkpoint: Module Five Project One
# Later use: get-item and inventory design for M7 Project Two
#
# Review the course-provided get-item flowchart before completing this file.
# Write pseudocode, not Python code. Use clear indentation and course-appropriate
# keywords such as INPUT, OUTPUT, IF, ELSE, SET, ADD, or similar terms.

START get_item

    SET current_room = player's current room
    SET inventory = player's inventory
    SET room_item = item in current_room

    OUTPUT "Enter the name of the item you want to get:"
    INPUT item_name

    IF item_name = room_item
        ADD room_item to inventory
        OUTPUT "You picked up " + room_item
        REMOVE room_item from current_room
    ELSE
        OUTPUT "That item is not in this room."
    END IF

END get_item


